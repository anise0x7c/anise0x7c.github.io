---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../consts";
import { getRecentPosts } from "../utils/posts";
import PostCard from "../components/PostCard.astro";
import ThemedButton from "../components/ThemedButton.astro";
import PageContainer from "../components/PageContainer.astro";

const recent = await getRecentPosts(6);
---

<BaseLayout>
  <PageContainer>
    <section class="hero">
      <p class="eyebrow">Hello there!</p>
      <h1 class="title">Welcome to 80ml Spice Jar</h1>
      <p class="lede">
        {SITE.description}, 由于几乎 100% 由 AI 构建 <br />
        谁知道下一秒会不会爆炸呢 😉
      </p>
      <div class="cta">
        <ThemedButton
          variant="solid"
          size="lg"
          href="/blogs"
          class="rounded-pill"
        >
          Read the blog
        </ThemedButton>
        <ThemedButton
          variant="outline"
          size="lg"
          href="https://github.com"
          class="rounded-pill"
        >
          GitHub
        </ThemedButton>
      </div>
    </section>

    {recent.length > 0 && (
    <section class="recent">
      <header class="section-head">
        <h2># Recent posts</h2>
      </header>
      <ul class="card-list">
        {recent.map((post) => (<li>
          <PostCard post={post} />
        </li>))}
      </ul>
    </section>)}
  </PageContainer>
</BaseLayout>



<style>
  .hero {
    background-color: var(--color-base);
    padding: clamp(1.5rem, 6vw, 3rem);
    margin-bottom: 4rem;
    border-radius: var(--radius-3xl);
    box-shadow: var(--shadow-card);
    transition: box-shadow 0.4s var(--ease-spring);
  }

  @media (max-width: 40rem) {
    .hero {
      border-radius: var(--radius-2xl);
      margin-bottom: 2.5rem;
    }
  }

  .hero:hover {
    box-shadow: var(--shadow-float);
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 1.3rem;
    line-height: 1;
    letter-spacing: -0.05em;
    font-weight: 700;
    color: var(--color-accent);
    margin: 0rem 0.3rem 0.7rem;
  }

  .title {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin-bottom: 0.3rem;
    max-width: 25ch;
  }

  .lede {
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--color-subtext1);
    margin: 0rem 0.3rem;
    max-width: 45ch;
  }

  .cta {
    display: flex;
    gap: 1.5rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .recent {
    padding-bottom: 0;
  }

  .section-head {
    border-radius: var(--radius-pill);
    padding: 1rem 2rem;
    margin-bottom: 1rem;
    background-color: var(--color-mantle);
  }

  .section-head h2 {
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0;
  }

  /* Must come after the base rules above: same specificity, later wins. */
  @media (max-width: 40rem) {
    .section-head {
      padding: 0.75rem 1.25rem;
    }

    .section-head h2 {
      font-size: 1.15rem;
    }
  }

  .section-head a {
    font-size: 0.9rem;
    color: var(--color-accent);
    text-decoration: none;
  }

  .card-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    /* min(Xrem, 100%) keeps the track from exceeding the viewport below
       Xrem — a bare minmax(30rem, 1fr) overflows horizontally on phones. */
    grid-template-columns: repeat(auto-fill, minmax(min(30rem, 100%), 1fr));
    gap: 2rem;
    align-items: stretch;
    @media (max-width: 40rem) {
      gap: 0.75rem;
    }
  }

  /* old deprecated */
  .old-card-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(25rem, 100%), 1fr));
    gap: 2rem;
    align-items: stretch;
  }

  .card-list > li {
    display: grid;
  }
</style>
