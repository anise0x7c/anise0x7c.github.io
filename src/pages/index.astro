---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../consts";
import { getRecentPosts } from "../utils/posts";
import PostCard from "../components/PostCard.astro";
import ThemedButton from "../components/ThemedButton.astro";

const recent = await getRecentPosts(6);
---

<BaseLayout>
  <div class="components">
    <section class="hero">
      <p class="eyebrow">Hello there!</p>
      <h1 class="title">Welcome to 80ml Spice Jar</h1>
      <p class="lede">
        {SITE.description}, 由于几乎 100% 由 AI 构建 <br />
        谁知道下一秒会不会爆炸呢 😉
      </p>
      <div class="cta">
        <ThemedButton
          variant="solid"
          size="lg"
          href="/blogs"
          class="rounded-lg"
        >
          Read the blog
        </ThemedButton>
        <ThemedButton
          variant="outline"
          size="lg"
          href="https://github.com"
          class="rounded-lg"
        >
          GitHub
        </ThemedButton>
      </div>
    </section>

    {recent.length > 0 && (
    <section class="recent">
      <header class="section-head">
        <h2># Recent posts</h2>
      </header>
      <ul class="card-list">
        {recent.map((post) => (<li>
          <PostCard post={post} />
        </li>))}
      </ul>
    </section>)}
  </div>
</BaseLayout>



<style>
  .components {
    max-width: var(--container-page);
    /* Base offset = regular band height − 20dvh overlap. The home-page
       extra height is applied as an animated translate (below), mirroring
       how the banner itself animates its height — so when body.is-home
       flips on navigation, nothing relayouts instantly; the hero glides
       with the shrinking/growing band instead of jumping. */
    margin: calc(var(--banner-h) - 10dvh) auto;
    padding: 0 1.5rem;
    /* Same params as .site-banner's height transition (BaseLayout) so the
       hero tracks the band edge exactly; translate is compositor-driven,
       no reflow of the article list below. */
    transition: translate 0.4s var(--ease-enter);
  }

  @media (min-width: 1024px) {
    body.is-home .components {
      /* +30dvh on desktop home (65 − 35), matching --banner-h-home */
      translate: 0 calc(var(--banner-h-home) - var(--banner-h));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .components {
      transition: none;
    }
  }

  .hero {
    background-color: var(--color-base);
    padding: 3rem;
    margin-bottom: 4rem;
    border-radius: var(--radius-3xl);
    box-shadow: var(--shadow-card);

    transition:
      box-shadow 0.4s var(--ease-spring), 
      background-color 0.4s var(--ease-spring);
  }

  .hero:hover {
    box-shadow: var(--shadow-float);
  }

  .eyebrow {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1;
    font-weight: 600;
    color: var(--color-accent-mns);
    margin: 0rem 0.3rem 0.7rem;
  }

  .title {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin-bottom: 0.3rem;
    max-width: 25ch;
  }

  .lede {
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--color-subtext1);
    margin: 0rem 0.3rem;
    max-width: 45ch;
  }

  .cta {
    display: flex;
    gap: 1.5rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .recent {
    padding-bottom: 90rem;
  }

  .section-head {
    border-radius: var(--radius-pill);
    padding: 1rem 2rem;
    margin-bottom: 1rem;
    background-color: var(--color-mantle);
  }

  .section-head h2 {
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .section-head a {
    font-size: 0.9rem;
    color: var(--color-accent-mns);
    text-decoration: none;
  }

  .card-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(30rem, 1fr));
    gap: 2rem;
    align-items: stretch;
  }

  /* old deprecated */
  .old-card-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(25rem, 1fr));
    gap: 2rem;
    align-items: stretch;
  }

  .card-list > li {
    display: grid;
  }
</style>
