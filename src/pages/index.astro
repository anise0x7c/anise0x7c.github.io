---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../consts";
import { getRecentPosts } from "../utils/posts";
import PostCard from "../components/PostCard.astro";
import ThemedButton from "../components/ThemedButton.astro";

const recent = await getRecentPosts(6);
---

<BaseLayout>
  <div class="components">
    <section class="hero">
      <p class="eyebrow">Hello there!</p>
      <h1 class="title">Welcome to 80ml Spice Jar</h1>
      <p class="lede">
        {SITE.description}, 由于几乎 100% 由 AI 构建 <br />
        谁知道下一秒会不会爆炸呢 😉
      </p>
      <div class="cta">
        <ThemedButton
          variant="solid"
          size="lg"
          href="/blogs"
          class="rounded-lg"
        >
          Read the blog
        </ThemedButton>
        <ThemedButton
          variant="outline"
          size="lg"
          href="https://github.com"
          class="rounded-lg"
        >
          GitHub
        </ThemedButton>
      </div>
    </section>

    {recent.length > 0 && (
    <section class="recent">
      <header class="section-head">
        <h2># Recent posts</h2>
      </header>
      <ul class="card-list">
        {recent.map((post) => (<li>
          <PostCard post={post} />
        </li>))}
      </ul>
    </section>)}
  </div>
</BaseLayout>



<style>
  .components {
    max-width: var(--container-page);
    margin: 45dvh auto;
    padding: 0 1.25rem;
  }

  .hero {
    background-color: color-mix(in srgb, var(--color-base) 75%, transparent);
    backdrop-filter: blur(5px) saturate(1.6);
    -webkit-backdrop-filter: blur(5px) saturate(1.6);
    padding: 3rem;
    border-radius: var(--radius-3xl);
    box-shadow: var(--shadow-card);

    transition:
      transform 0.4s var(--ease-bounce),
      box-shadow 0.4s var(--ease-bounce), 
      background-color 0.4s var(--ease-spring);
  }

  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    box-shadow: inset 0 0 0 1px var(--color-overlay0);
    transition: box-shadow 0.4s var(--ease-spring);
  }

  .hero:hover {
    transform: scale(1.02);
  }

  .card:hover::after {
    box-shadow: var(--shadow-lqdglass);
  }

  /* Firefox drops backdrop-filter inside view-transition snapshots
     (Bugzilla 1999295), so the glass card loses its blur for the whole
     animation. Astro brackets every client-side navigation with
     <html data-astro-transition="…">: set before startViewTransition
     (baked into the OLD snapshot), carried across the swap
     (non-overridable attr, baked into the NEW snapshot), removed when
     the transition finishes. Firefox applies :active-view-transition
     too late for the old snapshot — which is why leaving / still showed
     the broken glass. Do NOT add a transition on background-color —
     the gradient would be captured mid-way and the bug would resurface. */
  @supports (-moz-appearance: none) {
    html[data-astro-transition] .hero {
      transition: none;
      background-color: var(--color-base);
    }
  }

  .eyebrow {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1;
    font-weight: 600;
    color: var(--color-accent);
    margin: 0rem 0.3rem 0.7rem;
  }

  .title {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin-bottom: 0.3rem;
    max-width: 25ch;
  }

  .lede {
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--color-subtext1);
    margin: 0rem 0.3rem;
    max-width: 45ch;
  }

  .cta {
    display: flex;
    gap: 1.5rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .recent {
    padding-bottom: 20rem;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .section-head h2 {
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .section-head a {
    font-size: 0.9rem;
    color: var(--color-accent);
    text-decoration: none;
  }

  .card-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(30rem, 1fr));
    gap: 2rem;
    align-items: stretch;
  }

  .old-card-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(25rem, 1fr));
    gap: 2rem;
    align-items: stretch;
  }

  .card-list > li {
    display: grid;
  }
</style>
