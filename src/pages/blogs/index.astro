---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts } from "../../utils/posts";
import PostCard from "../../components/PostCard.astro";
import PageContainer from "../../components/PageContainer.astro";

const posts = await getPublishedPosts();
---

<BaseLayout title="Blog" description="All posts, newest first.">
  <PageContainer title="The Blog" subtitle="Everything I've written, newest first.">
    {
      posts.length === 0 ? (
        <p class="empty">
          <span class="empty-mark">✿</span> 还没有笔记 —— 很快就回来啦～
        </p>
      ) : (
        <ul class="card-grid">
          {posts.map((post) => (
            <li>
              <PostCard post={post} />
            </li>
          ))}
        </ul>
      )
    }
  </PageContainer>
</BaseLayout>

<style>
  .empty {
    font-family: var(--font-display);
    font-size: 1.6rem;
    color: var(--color-subtext0);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .empty-mark {
    color: var(--color-accent);
  }

  .card-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    /* min(30rem, 100%) keeps the track from exceeding the viewport below
       30rem — a bare minmax(30rem, 1fr) overflows horizontally on phones. */
    grid-template-columns: repeat(auto-fill, minmax(min(30rem, 100%), 1fr));
    gap: 1.5rem;
    align-items: stretch;
  }

  .card-grid > li {
    display: grid;
  }
</style>
