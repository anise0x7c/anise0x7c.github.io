---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts } from "../../utils/posts";
import PostCard from "../../components/PostCard.astro";

const posts = await getPublishedPosts();
---

<BaseLayout title="Blog" description="All posts, newest first.">
  <section class="container">
    <div class="page-head">
      <h1>The Blog</h1>
      <p>Everything I've written, newest first.</p>
    </div>

    {
      posts.length === 0 ? (
        <p class="empty">
          <span class="empty-mark">✿</span> 还没有笔记 —— 很快就回来啦～
        </p>
      ) : (
        <ul class="card-grid">
          {posts.map((post) => (
            <li>
              <PostCard post={post} />
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>

<style>
  .container {
    max-width: var(--container-page);
    margin: 0 auto;
    /* Start below the site-wide banner band (.site-bg in BaseLayout). */
    padding: calc(var(--banner-h) + 1.5rem) 1.25rem 4rem;
  }

  .page-head {
    margin-bottom: 2.5rem;
  }

  .page-head h1 {
    font-size: clamp(2rem, 5vw, 2.8rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .page-head p {
    margin: 0.5rem 0 0;
    color: var(--color-subtext1);
    font-size: 1.05rem;
  }

  .empty {
    font-family: var(--font-display);
    font-size: 1.6rem;
    color: var(--color-subtext0);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .empty-mark {
    color: var(--color-accent-mns);
  }

  .card-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: stretch;
  }

  .card-grid > li {
    display: grid;
  }
</style>
