---
import { SITE, NAV_LINKS } from "../consts";
import ThemedButton from "./ThemedButton.astro";
import SearchOverlay from "./SearchOverlay.svelte";

import SearchIcon from "../assets/icons/search.svg";

const pathname = Astro.url.pathname;
function isActive(href: string): boolean {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(href + "/");
}
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="site-logo">{SITE.title}</a>

    <nav class="header-nav" id="header-nav">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class:list={["nav-link", isActive(link.href) && "active"]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="header-tools">  
      <ThemedButton
        variant="flat"
        iconOnly
        title="Search"
        ariaLabel="Search"
        aria-haspopup="dialog"
        aria-expanded="false"
        data-search-trigger
        class="rounded-pill"
      >
      <SearchIcon slot="icon" />
      </ThemedButton>
      <ThemedButton
      variant="flat"
        iconOnly
        title="Toggle dark mode"
        ariaLabel="Toggle dark mode"
        data-theme-toggle
        class="rounded-pill"
      >
        <svg
        slot="icon"
        class="theme-sun"
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4" />
        <path
          d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
        />
      </svg>
      <svg
        slot="icon"
        class="theme-moon"
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
      </svg>
    </ThemedButton>
      <ThemedButton
        variant="flat"
        iconOnly
        title="Toggle navigation"
        ariaLabel="Toggle navigation"
        aria-expanded="false"
        aria-controls="header-nav"
        data-nav-toggle
        class="rounded-pill nav-toggle"
      >
        <svg
          slot="icon"
          class="icon-menu"
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg
          slot="icon"
          class="icon-close"
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </ThemedButton>
    </div>
  </div>
</header>

<!-- Search overlay island: bound to [data-search-trigger] above. client:load
     so ⌘K works before any interaction; the island itself renders nothing
     until opened. -->
<SearchOverlay client:load />



<script>
  // Bundled module scripts execute once per full page load, and the header
  // sits outside swup's swap container (<main>), so the toggle button DOM
  // node persists across navigations — bind once, directly. No re-binding
  // needed (that was only necessary when the whole <body> got replaced).
  const setupThemeToggle = () => {
    document
      .querySelector("[data-theme-toggle]")
      ?.addEventListener("click", () => {
        const isDark = document.documentElement.classList.toggle("dark");
        try {
          localStorage.setItem("theme", isDark ? "dark" : "light");
        } catch {
          /* storage may be unavailable */
        }
      });
  };
  setupThemeToggle();

  // Mobile nav disclosure (≤40rem): toggle + panel live in the persistent
  // header outside swup's swap container, so bind once, like above. The
  // open state is mirrored on .site-header[data-nav-open] which drives the
  // CSS (panel visibility + menu/close icon swap).
  const headerEl = document.querySelector(".site-header");
  const navToggle =
    document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const navPanel = document.querySelector(".header-nav");

  const setMobileNav = (open: boolean, moveFocus = true) => {
    const wasOpen = headerEl?.hasAttribute("data-nav-open") ?? false;
    headerEl?.toggleAttribute("data-nav-open", open);
    navToggle?.setAttribute("aria-expanded", String(open));
    if (!moveFocus) return;
    if (open && !wasOpen) {
      // Opening: hand focus to the first link so Tab flows through the
      // panel in DOM order (the panel sits before .header-tools).
      navPanel?.querySelector<HTMLAnchorElement>("a")?.focus();
    } else if (!open && wasOpen) {
      // Closing: return focus to the toggle, but only when focus was
      // parked inside the panel (Escape / outside click / link click) —
      // resize and scroll dismissals must not steal focus.
      if (navPanel?.contains(document.activeElement)) {
        navToggle?.focus();
      }
    }
  };

  navToggle?.addEventListener("click", () => {
    setMobileNav(!headerEl?.hasAttribute("data-nav-open"));
  });

  // Choosing a destination closes the panel — the header persists across
  // swup navigations, so it would otherwise stay open on the next page.
  document.querySelector(".header-nav")?.addEventListener("click", (event) => {
    if (event.target instanceof Element && event.target.closest("a")) {
      setMobileNav(false);
    }
  });

  // Taps outside the header and Escape both dismiss it.
  document.addEventListener("click", (event) => {
    if (
      headerEl?.hasAttribute("data-nav-open") &&
      event.target instanceof Node &&
      !headerEl.contains(event.target)
    ) {
      setMobileNav(false);
    }
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setMobileNav(false);
  });

  // Reset when the viewport grows past the mobile breakpoint (matches the
  // max-width: 40rem media query) or after any swup swap. Both are
  // programmatic dismissals — never steal focus back to the toggle.
  window
    .matchMedia("(min-width: 40rem)")
    .addEventListener("change", (e) => {
      if (e.matches) setMobileNav(false, false);
    });
  document.addEventListener("astro:after-swap", () => setMobileNav(false, false));

  // Sync the active nav link on swup navigations: the header persists
  // outside the swap container (<main>), so the SSR-rendered `active` class
  // would otherwise stay frozen on the page of the initial full load.
  // Mirrors the frontmatter isActive() logic exactly.
  const updateNavActive = () => {
    const pathname = location.pathname;
    document
      .querySelectorAll<HTMLAnchorElement>(".header-nav a[href]")
      .forEach((link) => {
        const href = link.getAttribute("href") ?? "";
        const active =
          href === "/"
            ? pathname === "/"
            : pathname === href || pathname.startsWith(href + "/");
        link.classList.toggle("active", active);
      });
  };
  updateNavActive();
  document.addEventListener("astro:after-swap", updateNavActive);

  // Hide-on-scroll: the listener is bound to `window` once; the header
  // element is re-queried every frame to avoid holding a stale reference.
  const HEADER_HIDE_THRESHOLD = 80;
  const HEADER_DEADZONE = 4;
  let headerLastY = window.scrollY;
  let headerRaf = false;

  const updateHeaderVisibility = () => {
    headerRaf = false;
    const header = document.querySelector(".site-header");
    if (!header) return;
    const y = window.scrollY;
    if (y <= HEADER_HIDE_THRESHOLD || y < headerLastY - HEADER_DEADZONE) {
      header.removeAttribute("data-hidden");
    } else if (y > headerLastY + HEADER_DEADZONE) {
      header.setAttribute("data-hidden", "");
      // The dropdown panel is anchored to the header — dismiss it along
      // with the header so it can't float over the page ownerless. Not a
      // user-initiated close, so don't move focus.
      setMobileNav(false, false);
    }
    headerLastY = y;
  };

  window.addEventListener(
    "scroll",
    () => {
      if (headerRaf) return;
      headerRaf = true;
      requestAnimationFrame(updateHeaderVisibility);
    },
    { passive: true },
  );

  // Every swup navigation scrolls back to the top — recalibrate the
  // baseline and un-hide the header. @swup/astro re-dispatches
  // astro:page-load on page:view (not on the initial load, which needs no
  // recalibration).
  document.addEventListener("astro:page-load", () => {
    headerLastY = window.scrollY;
    document.querySelector(".site-header")?.removeAttribute("data-hidden");
  });
</script>



<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    translate: 0 5px;
    max-width: var(--container-page);
    margin: auto;
    /* Same inline gutters as .page-container, so the pill's sides track the
       page content edges (incl. the tighter mobile override below). */
    padding-inline: clamp(1rem, 4vw, 1.5rem);
    transition: translate 0.3s var(--ease-bounce-soft);
  }

  @media (max-width: 40rem) {
    .site-header {
      padding-inline: 0.5rem;
    }
  }

  .site-header[data-hidden] {
    translate: 0 -101%;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }

    .site-header .header-nav {
      transition: none;
    }
  }

  .header-inner {
    background-color: color-mix(in srgb, var(--color-base) 70%, transparent);
    position: relative;
    z-index: 0;
    display: flex;
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-sticky);
    flex: 1;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.25rem;
  }


  .header-inner::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
  }

  .header-inner:hover {
    box-shadow:
      inset 5px 5px 20px rgba(255, 255, 255, 0.1),
      inset -5px -5px 30px rgba(255, 255, 255, 0.2);
  }

  @media (hover: none) {
    .header-inner:hover {
      /* 触屏没有真正的 hover:点击(包括点开移动端菜单)会让 :hover
         粘滞,药丸会一直保持放大 + 高亮阴影 */
      transform: none;
    }
  }

  .site-logo {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1; /* 行高 = 字号，防止撑高 header */
    color: var(--color-text);
    text-decoration: none; /* 去掉链接下划线 */
    /* Tripartite desktop layout: right auto (paired with .header-tools's
       margin-left:auto) centers the nav between logo and tools. */
    margin: 0 auto 0 0;
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .header-tools {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    /* Tripartite desktop layout: pins the tools to the pill's right edge */
    margin-left: auto;
  }

  .nav-link {
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-pill);
    font-size: 0.92rem;
    color: var(--color-text);
  }

  .nav-link:hover {
    background-color: color-mix(in srgb, var(--color-overlay2) 30%, transparent);
  }

  .nav-link.active{
    text-decoration: underline;
  }

  /* --- 汉堡按钮(仅移动端)与菜单/关闭图标切换 --- */

  .nav-toggle,
  .icon-close {
    display: none;
  }

  .site-header[data-nav-open] .icon-menu {
    display: none;
  }

  .site-header[data-nav-open] .icon-close {
    display: block;
  }

  /* --- 移动端 (≤40rem):单行布局 + 导航下拉面板 --- */

  @media (max-width: 40rem) {
    .header-inner {
      position: relative;
      /* .site-header 是 flex 容器,子项默认按内容收缩,
         需显式拉伸才能占满一行(margin-inline: 0 只去掉空隙) */
      flex: 1;
      flex-wrap: nowrap;
      min-height: 3rem;
      /* 满宽贴边:去掉两侧留白 */
      padding: 0.5rem 0.75rem;
    }

    .site-logo {
      margin: 0 auto 0 0.25rem;
      /* 0.85rem (not 0.8) — the 87.5% root font-size on mobile would take
         0.8rem down to ~11px; nudge it back up for brand legibility. */
      font-size: 0.85rem;
    }

    .header-tools {
      margin-left: 0;
      gap: 0;
    }

    .nav-toggle {
      display: inline-flex;
    }

    /* 导航复用为下拉面板:右对齐锚定在药丸下方,宽度随内容收缩。
       可见性用 visibility 而非 display:none —— 面板始终渲染,进出动画
       不依赖 transition-behavior: allow-discrete(display 过渡在部分
       浏览器/Safari 实现有缺陷:退出时 display:none 立即生效,会掐断
       opacity/translate 的过渡,菜单瞬间消失)。visibility 是离散可过渡
       属性,任何浏览器都能配合 opacity/translate 做完整的进出动画。
       translate 基态 -1rem = 进入起点 / 退出终点(弹出距离,进出对称)。 */
    .header-nav {
      position: absolute;
      top: calc(100% + 0.5rem);
      right: 0;
      min-width: 8rem;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0.25rem;
      padding: 0.375rem;
      background-color: color-mix(in srgb, var(--color-base) 50%, transparent);
      backdrop-filter: blur(5px);
      -webkit-backdrop-filter: blur(5px);
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow-card);
      /* Cap the panel to the viewport (future-proof for more links); the
         header itself is max 3.25rem + margins, hence the 6rem budget. */
      max-height: calc(100dvh - 6rem);
      overflow-y: auto;
      visibility: hidden;
      pointer-events: none;
      opacity: 0;
      translate: 0 -1rem;
      /* 退出:opacity/translate 立即过渡,visibility 延迟 0.4s 到动画
         结束后才隐藏 —— 退出因此有完整的淡出+上滑 */
      transition:
        opacity 0.4s var(--ease-spring),
        translate 0.4s var(--ease-spring),
        visibility 0s linear 0.4s;
    }

    .site-header[data-nav-open] .header-nav {
      visibility: visible;
      pointer-events: auto;
      opacity: 1;
      translate: 0 0;
      /* 进入:visibility 零延迟立即可见(opacity 才有起点可过渡),
         opacity/translate 走同一个 0.4s ease-spring */
      transition:
        opacity 0.4s var(--ease-spring),
        translate 0.4s var(--ease-spring),
        visibility 0s;
    }

    .nav-link {
      padding: 0.6rem 1rem;
      text-align: center;
    }
  }

  .theme-sun {
    display: none;
  }

  :global(.dark) .theme-sun {
    display: block;
  }

  .theme-moon {
    display: block;
  }

  :global(.dark) .theme-moon {
    display: none;
  }
</style>
