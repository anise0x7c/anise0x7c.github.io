---
interface Props {
  class?: string;
  /** Optional page heading — renders a shared .page-head block above the
      slot. Omit for pages that carry their own heading (e.g. home's hero). */
  title?: string;
  subtitle?: string;
}

const {
  class: className,
  title,
  subtitle,
} = Astro.props;
---

<div class:list={["page-container", className]}>
  {title && (
    <header class="page-head">
      <h1>{title}</h1>
      {subtitle && <p>{subtitle}</p>}
    </header>
  )}
  <slot />
</div>

<style>
  .page-container {
    max-width: var(--container-page);
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 1.5rem);
    /* Rise 10dvh into the sticky banner band by default; bottom spacing
       belongs to the Footer. */
    margin-top: calc(var(--banner-h) - 10dvh);
    /* Glide with the (taller, desktop) home banner on navigation — inert on
       regular pages, where translate never changes. */
    transition: translate 0.4s var(--ease-enter);
  }

  @media (min-width: 64rem) {
    body.is-home .page-container {
      translate: 0 calc(var(--banner-h-home) - var(--banner-h));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-container {
      transition: none;
    }
  }

  .page-head {
    /* Mantle chip (same treatment as the home "recent posts" section head)
       keeps the title readable where the page content overlaps the banner. */
    background-color: var(--color-base);
    box-shadow: var(--shadow-card);
    border-radius: var(--radius-3xl);
    padding: 2.5rem 3rem;
    margin-bottom: 2rem;
  }

  @media (max-width: 40rem) {
    .page-head {
      padding: 1.75rem 1.5rem;
      border-radius: var(--radius-2xl);
      margin-bottom: 1.5rem;
    }
  }

  .page-head h1 {
    font-size: clamp(2rem, 5vw, 2.8rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .page-head p {
    margin: 0.5rem 0 0;
    color: var(--color-subtext1);
    font-size: 1.05rem;
  }
</style>
