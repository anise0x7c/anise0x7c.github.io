---
import { SITE } from "../consts";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <p class="copy">
      &copy; {year} {SITE.author}. Built with <a href="https://astro.build">Astro</a>.
    </p>
    <a
      class="credit"
      href="https://www.pixiv.net/artworks/102421481"
      target="_blank"
       rel="noopener noreferrer"
     >
      ✨ Banner Artwork: 劇団 - 逐色
    </a>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    padding: 1.5rem 1.25rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    max-width: var(--container-page);
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .copy,
  .credit {
    font-size: 0.875rem;
    color: var(--color-subtext0);
    margin: 0;
  }

  /* .footer-inner 是 space-between：宽屏时声明落在右端，窄屏换行后跟随左列 */
  .copy a,
  .credit a {
    color: var(--color-subtext1);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
</style>
