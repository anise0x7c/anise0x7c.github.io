---
interface Props {
  variant?: "solid" | "outline" | "flat";
  size?: "sm" | "md" | "lg";
  iconOnly?: boolean;
  href?: string;
  type?: "button" | "submit";
  title?: string;
  ariaLabel?: string;
  class?: string;
}

const {
  variant = "outline",
  size = "md",
  iconOnly = false,
  href,
  type = "button",
  title,
  ariaLabel,
  class: extra,
  ...rest
} = Astro.props;

const classes = [
  "btn",
  `btn--${variant}`,
  iconOnly ? "btn--icon" : `btn--${size}`,
];
---

{
  href ? (
    <a href={href} class:list={[...classes, extra]} title={title} aria-label={ariaLabel} {...rest}>
      <slot name="icon" />
      <slot />
    </a>
  ) : (
    <button type={type} class:list={[...classes, extra]} title={title} aria-label={ariaLabel} {...rest}>
      <slot name="icon" />
      <slot />
    </button>
  )
}

<style>
  /* 放入 components 层:调用方传入的 Tailwind 工具类
     (rounded-lg / rounded-pill …)位于 utilities 层,仍可正常覆盖 */
  @layer components {
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      border-radius: var(--radius-md);

      transition:
        transform 0.4s var(--ease-bounce),
        box-shadow 0.4s var(--ease-spring),
        background-color 0.4s var(--ease-spring),
        color 0.4s var(--ease-spring);
    }

    /* 伪边框:inset shadow 不占布局空间,
       也避开 Firefox 细边框动画的子像素渲染问题 */
    .btn--outline {
      background-color: transparent;
      color: var(--color-subtext1);
      box-shadow: inset 0 0 0 1px var(--color-overlay0);
    }

    .btn--outline:hover {
      color: var(--color-text);
      background-color: var(--color-surface1);
      box-shadow: inset 0 0 0 1px var(--color-overlay2);
    }

    .btn--flat {
      background-color: transparent;
      color: var(--color-subtext1);
      box-shadow: inset 0 0 0 1px transparent;
    }

    .btn--flat:hover {
      color: var(--color-text);
      background-color: color-mix(in srgb, var(--color-overlay2) 30%, transparent);
    }

    .btn--solid {
      background-color: var(--color-accent-mns);
      color: var(--color-accent-mns-contrast);
      box-shadow:
        0 0 14px color-mix(in srgb, var(--color-accent-mns) 40%, transparent),
        0 0 32px color-mix(in srgb, var(--color-accent-mns) 20%, transparent);
    }

    .btn--solid:hover {
      background-color: var(--color-accent-mns-strong);
      box-shadow:
        0 0 22px color-mix(in srgb, var(--color-accent-mns-strong) 50%, transparent),
        0 0 52px color-mix(in srgb, var(--color-accent-mns-strong) 25%, transparent);
    }

    .btn--sm {
      gap: 0.375rem;
      padding: 0.375rem 0.75rem;
      font-size: 0.75rem;
      line-height: 1rem;
      font-weight: 600;
    }

    .btn--md {
      gap: 0.5rem;
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
      line-height: 1.25rem;
      font-weight: 500;
    }

    .btn--lg {
      gap: 0.5rem;
      padding: 0.625rem 1.25rem;
      font-size: 1rem;
      line-height: 1.5rem;
      font-weight: 700;
    }

    .btn--icon {
      width: 2.25rem;
      height: 2.25rem;
      padding: 0;
    }
  }
</style>
