---
import type { MarkdownHeading } from "astro";
import { Image } from "astro:assets";
import type { Post } from "../utils/posts";
import BaseLayout from "./BaseLayout.astro";
import PageContainer from "../components/PageContainer.astro";
import FormattedDate from "../components/FormattedDate.astro";

interface Props {
  post: Post;
  headings?: MarkdownHeading[];
}

const { post, headings = [] } = Astro.props;
const { title, description, pubDate, updatedDate, tags, cover, draft } = post.data;
const tocItems = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

<BaseLayout title={title} description={description}>
  <PageContainer>
  <article class="post" data-pagefind-body>
    <!-- cover -->
    { cover && (
      <div class="post-cover">
        <Image src={cover} alt="" width={1200} height={675} class="cover-img"/>
      </div>
    )}
    <!-- meta and draft indicator -->
    <div class="meta-row">
      <span class="date">
        {import.meta.env.DEV && draft && (<span>🚧 - </span>)}
        <FormattedDate date={pubDate} />
      </span>
      { updatedDate && (
        <span class="updated">
          (updated <FormattedDate date={updatedDate} />)
        </span>
      )}
    </div>
    <!-- title -->
    <h1>{title}</h1>
    <!-- tags -->
    { tags.length > 0 && (
      <ul class="tags" data-pagefind-ignore>
        {tags.map((tag) => (
          <li> <span class="chip">#{tag}</span> </li>
        ))}
      </ul>
    )}
    <!-- discription -->
    <p class="lead">{description}</p>
    <!-- prose and toc -->
    <div class="post-text">
      <div class="prose">
        <slot />
      </div>
      { tocItems.length > 0 && (
        <aside class="toc" aria-label="Table of contents" data-pagefind-ignore>
          <div class="toc-indicator" aria-hidden="true"></div>
          <div class="toc-title">ON THIS PAGE</div>
          <nav>
            <ul>
              {tocItems.map((item) => (
                <li class:list={["toc-item", { indent: item.depth === 3 }]}>
                  <a href={`#${item.slug}`}>{item.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )}
    </div>

    <div class="post-footer" data-pagefind-ignore>
      <a href="/blogs">&larr; Back to all posts</a>
    </div>
  </article>
  </PageContainer>
</BaseLayout>



<script>
  // TOC scroll-spy (Fuwari-style, section-based). Posts are sectionized
  // (src/plugins/sectionize), so each TOC entry's heading.parentElement is
  // its section. A section is active while any part of it intersects the
  // viewport; the highlight — a single floating bar — spans the trailing run
  // of consecutive active sections (reading an h3 usually also keeps its
  // parent h2's section in view, so the bar covers the h2…h3 links).
  //
  // A plain-viewport IntersectionObserver is the change trigger: sections
  // entering or leaving it are exactly when the run can change, so no scroll
  // listener is needed. On swup navigations the astro:page-load listener
  // re-attaches to each swapped document; the cleanup guard keeps repeat
  // invocations idempotent.
  let cleanup: (() => void) | null = null;
  const setupToc = () => {
    cleanup?.();
    cleanup = null;
    const toc = document.querySelector<HTMLElement>(".toc");
    if (!toc) return;
    const indicator = toc.querySelector<HTMLElement>(".toc-indicator");
    const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>("a"));
    const sections: HTMLElement[] = [];
    links.forEach((link) => {
      const raw = (link.getAttribute("href") ?? "").slice(1);
      let id = raw;
      try {
        id = decodeURIComponent(raw);
      } catch {
        /* malformed escape sequence — fall back to the raw slug */
      }
      const section = document.getElementById(id)?.parentElement;
      if (section instanceof HTMLElement) sections.push(section);
    });
    if (sections.length === 0) return;

    const update = () => {
      const vh = window.innerHeight;
      const active = sections.map((s) => {
        const rect = s.getBoundingClientRect();
        return rect.top < vh && rect.bottom > 0;
      });

      // Trailing run of consecutive active sections: skip inactive ones at
      // the end, then gather the contiguous active stretch before them.
      let max = sections.length - 1;
      while (max >= 0 && !active[max]) max--;
      let min = max;
      while (min - 1 >= 0 && active[min - 1]) min--;

      for (let i = 0; i < links.length; i++) {
        if (i === max) {
          links[i].setAttribute("aria-current", "true");
        } else {
          links[i].removeAttribute("aria-current");
        }
      }

      // Glide the indicator over the active run; hide it when none is in
      // view (the reader is still in the intro).
      if (!indicator) return;
      if (max < 0) {
        indicator.style.opacity = "0";
        return;
      }

      const tocRect = toc.getBoundingClientRect();
      const firstRect = links[min].getBoundingClientRect();
      const lastRect = links[max].getBoundingClientRect();
      indicator.style.top = `${firstRect.top - tocRect.top + toc.scrollTop}px`;
      indicator.style.height = `${lastRect.bottom - firstRect.top}px`;
      indicator.style.opacity = "1";
    };

    const observer = new IntersectionObserver(update, {
      threshold: 0,
    });
    for (const section of sections) observer.observe(section);
    // Fonts settling can shift geometry after setup — re-check once.
    document.fonts?.ready.then(() => update()).catch(() => {});

    cleanup = () => observer.disconnect();
    update();
  };
  if (document.querySelector(".toc")) setupToc();
  document.addEventListener("astro:page-load", setupToc);
</script>



<style>
  .post {
    /* Full-width card spanning the container (matches the page-head cards) */
    background-color: var(--color-base);
    box-shadow: var(--shadow-card);
    border-radius: var(--radius-3xl);
    padding: clamp(1.25rem, 6vw, 2.5rem);
  }

  @media (max-width: 40rem) {
    .post {
      border-radius: var(--radius-2xl);
    }
  }

  .post-cover {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-xl);
    margin-bottom: 1.5rem;
  }

  @media (max-width: 40rem) {
    .post-cover {
      border-radius: var(--radius-lg);
      margin-bottom: 1.25rem;
    }
  }

  .cover-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-subtext0);
  }

  .post h1 {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0.75rem 0 0;
  }

  .lead {
    font-size: 1.15rem;
    color: var(--color-subtext1);
    line-height: 1.6;
    margin: 1rem 0 1.5rem;
    padding: 1rem 0 1rem;
    border-bottom: solid 2px var(--color-overlay0);
  }

  @media (max-width: 40rem) {
    .lead {
      font-size: 1.05rem;
    }
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }

  .post-text {
    display: flex;
    gap: 1.5rem;
  }

  .prose {
    flex: 1;
    min-width: 0;
  }

  /* TOC: hidden below lg; a sticky right column of .post-grid above. It is
     part of the page content (in the swup swap container), which is safe —
     sticky anchors to the viewport scrollport, and the animated page wrapper
     ends every transition at translateY(0) ≡ identity, so there is no jump.
     No own background/shadow — the TOC sits inside the .post card, which
     already carries the base surface + shadow. */
  .toc {
    display: none;
  }

  .toc-title {
    font-weight: 800;
    color: var(--color-accent);
    border-left: solid 3px var(--color-accent);
    padding: 0 0.5rem 0;
    margin: 0 0.3rem 1.3rem;
  }

  @media (min-width: 64rem) /* = --breakpoint-lg (1024px) */ {
    .toc {
      display: block;
      position: sticky;
      flex-shrink: 0;
      top: 10dvh;
      max-height: calc(100dvh - 10dvh - 1.5rem);
      overflow-y: auto;
      /* Adaptive-but-capped column: width = min(max-content, 16rem), so a
         very long heading wraps here instead of squeezing .prose. */
      max-width: 16rem;
      /* Contain the indicator's negative z-index so it sits behind the links
         but stays above the .post card background. */
      isolation: isolate;
    }
  }

  .toc-indicator {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0;
    background: var(--color-accent-soft);
    border-radius: var(--radius-md);
    pointer-events: none;
    transition:
      top 0.2s var(--ease-bounce-soft),
      height 0.2s var(--ease-bounce-soft),
      opacity 0.2s var(--ease-bounce-soft);
  }

  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.2rem;
  }

  .toc-item.indent {
    padding-left: 0.75rem;
  }

  .toc-item a {
    display: block;
    padding: 0.5rem;
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--color-subtext1);
    text-decoration: none;
    border-radius: var(--radius-md);
    box-shadow: inset 0 0 0 1px transparent;
    /* Long headings wrap; `anywhere` also breaks unbreakable tokens (URLs) */
    overflow-wrap: anywhere;
  }

  .toc-item a:hover {
    color: var(--color-text);
    box-shadow: inset 0 0 0 1px var(--color-overlay0);
  }

  .post-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-overlay0);
    font-size: 0.9rem;
  }

  .post-footer a {
    color: var(--color-subtext1);
    text-decoration: none;
  }

  .post-footer a:hover {
    color: var(--color-accent);
  }
</style>
