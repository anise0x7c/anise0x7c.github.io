---
import type { MarkdownHeading } from "astro";
import { Image } from "astro:assets";
import type { Post } from "../utils/posts";
import { stickerColor } from "../utils/color";
import BaseLayout from "./BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";

interface Props {
  post: Post;
  headings?: MarkdownHeading[];
}

const { post, headings = [] } = Astro.props;
const { title, description, pubDate, updatedDate, tags, cover, draft } = post.data;
const tocItems = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const hasToc = tocItems.length > 0;
---

<BaseLayout title={title} description={description}>
  <article
    class="post"
    class:list={{ "has-toc": hasToc }}
    data-pagefind-body
  >
    <header class="post-header">
      {
        cover && (
          <div class="post-cover">
            <Image src={cover} alt="" width={1200} height={675} />
          </div>
        )
      }
      <div class="meta-row">
        <span class="date">
          {import.meta.env.DEV && draft && (<span>🚧 - </span>)}
          <FormattedDate date={pubDate} />
        </span>
        {
          updatedDate && (
            <span class="updated">
              (updated <FormattedDate date={updatedDate} />)
            </span>
          )
        }
      </div>
      <h1>{title}</h1>
      {
        tags.length > 0 && (
          <ul class="tags" data-pagefind-ignore>
            {tags.map((tag) => (
              <li>
                <span class="chip" style={`--tag-color: ${stickerColor(tag)}`}>
                  #{tag}
                </span>
              </li>
            ))}
          </ul>
        )
      }
      <p class="lead">{description}</p>
    </header>

    <div class="post-body" class:list={{ "with-toc": hasToc }}>
      <div class="prose">
        <slot />
      </div>
      {
        hasToc && (
          <aside class="toc" aria-label="Table of contents" data-pagefind-ignore>
            <p class="toc-title">On this page</p>
            <nav>
              <ul>
                {tocItems.map((h) => (
                  <li class:list={["toc-item", { indent: h.depth === 3 }]}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )
      }
    </div>

    <footer class="post-footer" data-pagefind-ignore>
      <a href="/blogs">&larr; Back to all posts</a>
    </footer>
  </article>
</BaseLayout>

<script>
  // Re-run on every client-side navigation (also fires on first load) so the
  // TOC observer is attached to the freshly swapped document.
  const setupToc = () => {
    const toc = document.querySelector<HTMLElement>(".toc");
    if (!toc) return;
    const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>("a"));
    const linkMap = new Map<Element, HTMLAnchorElement>();
    for (const link of links) {
      const id = decodeURIComponent(
        (link.getAttribute("href") ?? "").slice(1),
      );
      const target = document.getElementById(id);
      if (target) linkMap.set(target, link);
    }
    const targets = Array.from(linkMap.keys());

    let activeLink: HTMLAnchorElement | null = links[0] ?? null;
    if (activeLink) activeLink.classList.add("active");

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const link = linkMap.get(entry.target);
            if (link && link !== activeLink) {
              activeLink?.classList.remove("active");
              link.classList.add("active");
              activeLink = link;
            }
          }
        }
      },
      { rootMargin: "-90px 0px -70% 0px", threshold: 0 },
    );
    for (const target of targets) observer.observe(target);
  };
  document.addEventListener("astro:page-load", setupToc);
</script>

<style>
  .post {
    max-width: var(--container-prose);
    margin-inline: auto;
    /* Start below the site-wide banner band (.site-bg in BaseLayout). */
    padding: calc(var(--banner-h) + 1.5rem) 1.25rem 4rem;
  }

  /* On wide screens, give the article page a wider shell so the body + TOC
     can sit side by side. Below `lg` it collapses to the prose measure. */
  @media (min-width: 1024px) {
    .post.has-toc {
      max-width: var(--container-article);
    }
  }

  .post-header {
    margin-bottom: 2.5rem;
  }

  .post-cover {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-lg);
    margin-bottom: 1.5rem;
  }

  .post-cover :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-subtle);
  }

  .post-header h1 {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0.75rem 0 0;
  }

  .lead {
    font-size: 1.15rem;
    color: var(--color-muted);
    margin: 1rem 0 0;
    line-height: 1.6;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }

  .post-body {
    display: block;
  }

  @media (min-width: 1024px) {
    .post-body.with-toc {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 15rem;
      gap: 3rem;
      align-items: start;
    }
  }

  /* Table of contents sidebar */
  .toc {
    display: none;
  }

  @media (min-width: 1024px) {
    .post-body.with-toc .toc {
      display: block;
      position: sticky;
      top: 4.5rem;
      max-height: calc(100vh - 6rem);
      overflow-y: auto;
    }
  }

  .toc-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 0.5rem;
  }

  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.1rem;
  }

  .toc-item {
    border-left: 1px dashed var(--color-border-strong);
  }

  .toc-item.indent {
    padding-left: 0.75rem;
  }

  .toc-item a {
    display: block;
    padding: 0.2rem 0 0.2rem 0.65rem;
    margin-left: -1px;
    border-left: 1px solid transparent;
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--color-muted);
    text-decoration: none;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .toc-item a:hover {
    color: var(--color-text);
  }

  .toc-item a.active {
    color: var(--color-accent);
    border-left-color: var(--color-accent);
    font-weight: 500;
  }

  .post-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.9rem;
  }

  .post-footer a {
    color: var(--color-muted);
    text-decoration: none;
  }

  .post-footer a:hover {
    color: var(--color-accent);
  }
</style>
