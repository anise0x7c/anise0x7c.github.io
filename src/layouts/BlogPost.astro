---
import type { MarkdownHeading } from "astro";
import { Image } from "astro:assets";
import type { Post } from "../utils/posts";
import BaseLayout from "./BaseLayout.astro";
import PageContainer from "../components/PageContainer.astro";
import FormattedDate from "../components/FormattedDate.astro";

interface Props {
  post: Post;
  headings?: MarkdownHeading[];
}

const { post, headings = [] } = Astro.props;
const { title, description, pubDate, updatedDate, tags, cover, draft } = post.data;
const tocItems = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

<BaseLayout title={title} description={description}>
  <PageContainer>
  <article class="post" data-pagefind-body>
    <!-- cover -->
    { cover && (
      <div class="post-cover">
        <Image src={cover} alt="" width={1200} height={675} class="cover-img"/>
      </div>
    )}
    <!-- meta and draft indicator -->
    <div class="meta-row">
      <span class="date">
        {import.meta.env.DEV && draft && (<span>🚧 - </span>)}
        <FormattedDate date={pubDate} />
      </span>
      { updatedDate && (
        <span class="updated">
          (updated <FormattedDate date={updatedDate} />)
        </span>
      )}
    </div>
    <!-- title -->
    <h1>{title}</h1>
    <!-- tags -->
    { tags.length > 0 && (
      <ul class="tags" data-pagefind-ignore>
        {tags.map((tag) => (
          <li> <span class="chip">#{tag}</span> </li>
        ))}
      </ul>
    )}
    <!-- discription -->
    <p class="lead">{description}</p>
    <!-- prose and toc -->
    <div class="post-text">
      <div class="prose">
        <slot />
      </div>
      { tocItems.length > 0 && (
        <aside class="toc" aria-label="Table of contents" data-pagefind-ignore>
          <nav>
            <ul>
              {tocItems.map((item) => (
                <li class:list={["toc-item", { indent: item.depth === 3 }]}>
                  <a href={`#${item.slug}`}>{item.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )}
    </div>

    <div class="post-footer" data-pagefind-ignore>
      <a href="/blogs">&larr; Back to all posts</a>
    </div>
  </article>
  </PageContainer>
</BaseLayout>



<script>
  // TOC scroll-spy. Rendered only when the post has headings; this module
  // script runs after DOM parse on full loads. On swup navigations the head
  // is synced with the incoming page's <script> tags — a module script added
  // mid-session executes once and registers the astro:page-load listener
  // (@swup/astro re-dispatches it on page:view), re-attaching the observer
  // to each freshly swapped document. The disconnect guard makes repeated
  // invocations idempotent.
  let observer: IntersectionObserver | null = null;
  const setupToc = () => {
    if (observer) {
      observer.disconnect();
      observer = null;
    }
    const toc = document.querySelector<HTMLElement>(".toc");
    if (!toc) return;
    const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>("a"));
    const linkMap = new Map<Element, HTMLAnchorElement>();
    for (const link of links) {
      const id = decodeURIComponent((link.getAttribute("href") ?? "").slice(1));
      const target = document.getElementById(id);
      if (target) linkMap.set(target, link);
    }
    const targets = Array.from(linkMap.keys());

    let activeLink: HTMLAnchorElement | null = links[0] ?? null;
    if (activeLink) activeLink.classList.add("active");

    const obs = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const link = linkMap.get(entry.target);
            if (link && link !== activeLink) {
              activeLink?.classList.remove("active");
              link.classList.add("active");
              activeLink = link;
            }
          }
        }
      },
      { rootMargin: "-90px 0px -70% 0px", threshold: 0 },
    );
    observer = obs;
    for (const target of targets) obs.observe(target);
  };
  if (document.querySelector(".toc")) setupToc();
  document.addEventListener("astro:page-load", setupToc);
</script>



<style>
  .post {
    /* Full-width card spanning the container (matches the page-head cards) */
    background-color: var(--color-base);
    box-shadow: var(--shadow-card);
    border-radius: var(--radius-3xl);
    padding: 2.5rem 3rem;
  }

  .post-cover {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-xl);
    margin-bottom: 1.5rem;
  }

  .cover-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-subtext0);
  }

  .post h1 {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0.75rem 0 0;
  }

  .lead {
    font-size: 1.15rem;
    color: var(--color-subtext1);
    margin: 1rem 0 0;
    line-height: 1.6;
    padding: 1rem 0;
    margin-bottom: 1rem ;
    border-bottom: dashed 2px var(--color-overlay0);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }

  .post-text {
    display: flex;
    gap: 2rem;
  }

  .prose {
    flex: 1;
    min-width: 0;
  }

  /* TOC: hidden below lg; a sticky right column of .post-grid above. It is
     part of the page content (in the swup swap container), which is safe —
     sticky anchors to the viewport scrollport, and the animated page wrapper
     ends every transition at translateY(0) ≡ identity, so there is no jump.
     No own background/shadow — the TOC sits inside the .post card, which
     already carries the base surface + shadow. */
  .toc {
    display: none;
  }

  @media (min-width: 64rem) /* = --breakpoint-lg (1024px) */ {
    .toc {
      display: block;
      position: sticky;
      flex-shrink: 0;
      top: 10dvh;
      max-height: calc(100dvh - 10dvh - 1.5rem);
      overflow-y: auto;
    }
  }

  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.1rem;
  }

  .toc-item {
    border-left: 1px dashed var(--color-overlay2);
  }

  .toc-item.indent {
    padding-left: 0.75rem;
  }

  .toc-item a {
    display: block;
    padding: 0.2rem 0 0.2rem 0.65rem;
    margin-left: -1px;
    border-left: 1px solid transparent;
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--color-subtext1);
    text-decoration: none;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .toc-item a:hover {
    color: var(--color-text);
  }

  .toc-item a.active {
    color: var(--color-accent);
    border-left-color: var(--color-accent);
    font-weight: 500;
  }

  .post-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-overlay0);
    font-size: 0.9rem;
  }

  .post-footer a {
    color: var(--color-subtext1);
    text-decoration: none;
  }

  .post-footer a:hover {
    color: var(--color-accent);
  }
</style>
