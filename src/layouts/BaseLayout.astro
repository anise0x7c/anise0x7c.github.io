---
import { ClientRouter } from "astro:transitions";
import { Font, Image } from "astro:assets";
import "../styles/global.css";
import { SITE } from "../consts";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Background from "../assets/images/chasing-color-hrz.jpg";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="zh-CN" transition:name="root" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <meta name="twitter:card" content="summary_large_image" />

    <ClientRouter />

    <!-- Self-hosted web fonts (see `fonts` in astro.config.mjs): Nunito
         (rounded sans body), Caveat + Ma Shan Zheng (handwritten accents).
         Preload only the above-the-fold Latin faces; the CJK font ships as
         unicode-range slices fetched by the browser on demand. -->
    <Font cssVariable="--font-nunito" preload={[{ weight: "400" }]} />
    <Font cssVariable="--font-caveat" preload={[{ weight: "600" }]} />
    <Font cssVariable="--font-mashanzheng" />
    <Font cssVariable="--font-jetbrains-mono" />

    <!-- Theme is applied before first paint to avoid a flash of the wrong mode.
         Runs inline, synchronously, in <head>. Re-applied on `astro:after-swap`
         so the correct theme persists across client-side navigations. -->
    <script is:inline>
      (() => {
        const key = "theme";
        const apply = () => {
          let theme;
          try {
            theme = localStorage.getItem(key);
          } catch {
            theme = null;
          }
          const prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)",
          ).matches;
          if (theme === "dark" || (!theme && prefersDark)) {
            document.documentElement.classList.add("dark");
          }
        };
        apply();
        document.addEventListener("astro:after-swap", apply);
      })();
    </script>
  </head>
  <body>
    <!-- Site-wide banner band (fuwari-style top strip). Frozen via
         transition:animate="none" and stacked ABOVE the root group during
         view transitions (see animations.css) — the root snapshot always
         bakes an opaque canvas, so any static layer below it would be
         hidden for the duration of the animation. -->
    <div
      class="site-banner"
      transition:name="site-banner"
      transition:animate="none"
      aria-hidden="true"
    >
      <Image
        src={Background}
        alt=""
        class="band"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  import type { TransitionBeforeSwapEvent } from "astro:transitions/client";

  // Context-aware page transitions: classify each navigation by route depth and
  // tag the incoming <html> with data-vt-nav so CSS picks drill/back/sibling
  // animations. The marker is transient — only consulted by ::view-transition-*
  // rules during the animation; it lingers after the transition by design and is
  // harmless (each navigation re-stamps a freshly fetched document). Bundled
  // scripts run once; the listener stays alive across swaps.
  const depth = (path: string): number =>
    path.split("/").filter(Boolean).length;

  document.addEventListener("astro:before-swap", (event) => {
    const e = event as TransitionBeforeSwapEvent;
    const fd = depth(e.from.pathname);
    const td = depth(e.to.pathname);
    const nav = td > fd ? "drill" : td < fd ? "back" : "sibling";
    e.newDocument.documentElement.dataset.vtNav = nav;
    // Keep dark mode across navigations: swapRootAttributes copies the
    // incoming <html>'s attributes, so stamp the class before the swap.
    // Otherwise the theme is lost → light body anchored by scrollTo's forced
    // layout → its background-color transition fires → white flash on back-nav.
    if (document.documentElement.classList.contains("dark")) {
      e.newDocument.documentElement.classList.add("dark");
    }
  });

  
  const VT_GLASS = "data-vt-glass";
  document.addEventListener("astro:before-preparation", () => {
    document.documentElement.setAttribute(VT_GLASS, "");
  });
  document.addEventListener("astro:before-swap", (event) => {
    const e = event as TransitionBeforeSwapEvent;
    e.newDocument.documentElement.setAttribute(VT_GLASS, "");
    e.viewTransition?.finished.finally(() =>
      document.documentElement.removeAttribute(VT_GLASS),
    );
  });
  document.addEventListener("astro:page-load", () =>
    document.documentElement.removeAttribute(VT_GLASS),
  );
</script>

<style is:global>
  main {
    display: block;
    min-height: calc(100vh - 3.75rem);
  }
</style>

<style>
  /*
    The banner band only — paper colour stays on the canvas (body in
    global.css) because the root VT snapshot bakes the canvas opaquely.
    Height token: --banner-h (themes.css); freeze + z-index rules:
    animations.css.
  */
  .site-banner {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--banner-h);
    z-index: -1;
    pointer-events: none;
  }

  .band {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-bottom: solid 15px #efeeeb;
    box-shadow: var(--shadow-sticky);
  }
</style>
