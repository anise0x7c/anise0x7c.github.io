---
import { Font, Image } from "astro:assets";
import "../styles/global.css";
import { SITE, DEFAULT_HUE } from "../consts";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Background from "../assets/images/chasing-color-hrz.jpg";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);

// Home page gets a taller banner band (desktop only, via --banner-h-effective
// below). Server-rendered for full page loads; swup navigations toggle it in
// the visit:start hook further down so the height morph starts instantly.
const isHome = Astro.url.pathname === "/";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" /> 

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <meta name="twitter:card" content="summary_large_image" />

    <!-- Self-hosted web fonts (see `fonts` in astro.config.mjs): Nunito
         (rounded sans body) and JetBrains Mono (code). Preload only the
         above-the-fold Latin faces; CJK/emoji fall through to system fonts
         via --font-nunito's metric-optimized fallbacks. -->
    <Font cssVariable="--font-nunito" preload={[{ weight: "400" }]} />
    <Font cssVariable="--font-jetbrains-mono" />

    <!-- Theme + hue knob are applied before first paint to avoid a flash of
         the wrong mode/colour. Runs inline, synchronously, in <head> on every
         full page load. No listener needed for swup navigations: swup only
         swaps <main>, so <html>, its .dark class and the inline --hue style
         survive every navigation untouched. -->
    <script is:inline define:vars={{ defaultHue: DEFAULT_HUE }}>
      (() => {
        const key = "theme";
        let theme;
        try {
          theme = localStorage.getItem(key);
        } catch {
          theme = null;
        }
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        if (theme === "dark" || (!theme && prefersDark)) {
          document.documentElement.classList.add("dark");
        }
      })();

      (() => {
        // Hue knob (Fuwari-style): every oklch(L C var(--hue)) token in
        // themes.css resolves against this property. Restored from
        // localStorage; validated to keep dirty/corrupt values out.
        let hue = defaultHue;
        try {
          // Read the raw string first: Number(null) === 0 (not NaN), so a
          // missing key must be checked explicitly — otherwise a cleared
          // storage silently forces hue 0 instead of falling back to the
          // configured default.
          const raw = localStorage.getItem("hue");
          if (raw !== null) {
            const stored = Number(raw);
            if (Number.isFinite(stored) && stored >= 0 && stored < 360) {
              hue = stored;
            }
          }
        } catch {
          /* storage may be unavailable */
        }
        document.documentElement.style.setProperty("--hue", String(hue));
      })();
    </script>
  </head>
  <body class:list={[{ "is-home": isHome }]}>
    <!-- Site-wide banner band (fuwari-style top strip). Lives OUTSIDE swup's
         swap container (<main>), so the element — and its decoded image —
         persist across every navigation; the height morph is a plain CSS
         transition on --banner-h-effective (no snapshot layering). -->
    <div class="site-banner" aria-hidden="true">
      <Image
        src={Background}
        alt=""
        class="band"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <Header />
    <!-- Swup swap container + animation anchor: swup swaps the whole <main>;
         the `transition-swup-*` class lives on an inner wrapper (NOT on
         <main>) so page transitions never put a transform on <main> itself —
         a transformed ancestor would re-anchor fixed/sticky descendants.
         The sticky TOC lives inside the page content now (a right column of
         the post body); that is safe — sticky anchors to the viewport
         scrollport, and the wrapper ends every animation at translateY(0) ≡
         identity, so there is no jump. Out/in animations are bound to
         html.is-leaving / is-rendering in styles/animations.css. -->
    <main>
      <div class="transition-swup-page">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>

<script>
  // Toggle the home banner height class the instant a link is clicked, so
  // the CSS height transition runs in parallel with the page transition.
  // Syncing the class from the incoming document (e.g. body-class plugin or
  // content:replace) would only flip it after the out-animation — the morph
  // would start late. Mirrors Fuwari's visit:start handler. Swup initializes
  // on idle, so guard for window.swup not existing yet.
  const setup = () => {
    (window as any).swup.hooks.on(
      "visit:start",
      (visit: { to: { url: string } }) => {
        const path = new URL(visit.to.url, location.origin).pathname;
        document.body.classList.toggle("is-home", path === "/");
      },
    );
  };
  if ((window as any).swup) {
    setup();
  } else {
    document.addEventListener("swup:enable", setup);
  }
</script>

<script>
  // TOC scroll-spy (Fuwari-style, section-based). Posts are sectionized
  // (src/plugins/sectionize), so each TOC entry's heading.parentElement is
  // its section. A section is active while any part of it intersects the
  // viewport; the highlight — a single floating bar — spans the trailing run
  // of consecutive active sections (reading an h3 usually also keeps its
  // parent h2's section in view, so the bar covers the h2…h3 links).
  //
  // A plain-viewport IntersectionObserver is the change trigger: sections
  // entering or leaving it are exactly when the run can change, so no scroll
  // listener is needed. On swup navigations the astro:page-load listener
  // re-attaches to each swapped document; the cleanup guard keeps repeat
  // invocations idempotent.
  //
  // Lives in BaseLayout, not BlogPost: Astro hoists this script outside
  // swup's swap container (<main>), and scripts parsed out-of-document
  // never execute when swup swaps <main> in. Scoped to BlogPost, it would
  // only run on a full page load of a post — landing on the home/list first
  // and swup-navigating into a post would leave the TOC uninitialized (no
  // highlight bar, no scroll-spy) until a refresh. Every page loads this
  // layout, so the astro:page-load listener is registered before the first
  // swup navigation; on non-post pages the .toc guard makes it a no-op.
  let cleanup: (() => void) | null = null;
  const setupToc = () => {
    cleanup?.();
    cleanup = null;
    const toc = document.querySelector<HTMLElement>(".toc");
    if (!toc) return;
    const indicator = toc.querySelector<HTMLElement>(".toc-indicator");
    const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>("a"));
    const sections: HTMLElement[] = [];
    links.forEach((link) => {
      const raw = (link.getAttribute("href") ?? "").slice(1);
      let id = raw;
      try {
        id = decodeURIComponent(raw);
      } catch {
        /* malformed escape sequence — fall back to the raw slug */
      }
      const section = document.getElementById(id)?.parentElement;
      if (section instanceof HTMLElement) sections.push(section);
    });
    if (sections.length === 0) return;

    const update = () => {
      const vh = window.innerHeight;
      const active = sections.map((s) => {
        const rect = s.getBoundingClientRect();
        return rect.top < vh && rect.bottom > 0;
      });

      // Trailing run of consecutive active sections: skip inactive ones at
      // the end, then gather the contiguous active stretch before them.
      let max = sections.length - 1;
      while (max >= 0 && !active[max]) max--;
      let min = max;
      while (min - 1 >= 0 && active[min - 1]) min--;

      for (let i = 0; i < links.length; i++) {
        if (i === max) {
          links[i].setAttribute("aria-current", "true");
        } else {
          links[i].removeAttribute("aria-current");
        }
      }

      // Glide the indicator over the active run; hide it when none is in
      // view (the reader is still in the intro).
      if (!indicator) return;
      if (max < 0) {
        indicator.style.opacity = "0";
        return;
      }

      const tocRect = toc.getBoundingClientRect();
      const firstRect = links[min].getBoundingClientRect();
      const lastRect = links[max].getBoundingClientRect();
      indicator.style.top = `${firstRect.top - tocRect.top + toc.scrollTop}px`;
      indicator.style.height = `${lastRect.bottom - firstRect.top}px`;
      indicator.style.opacity = "1";
    };

    const observer = new IntersectionObserver(update, {
      threshold: 0,
    });
    for (const section of sections) observer.observe(section);
    // Fonts settling can shift geometry after setup — re-check once.
    document.fonts?.ready.then(() => update()).catch(() => {});

    cleanup = () => observer.disconnect();
    update();
  };
  if (document.querySelector(".toc")) setupToc();
  document.addEventListener("astro:page-load", setupToc);
</script>

<style is:global>
  main {
    display: block;
    min-height: calc(100vh - 3.75rem);
  }

  /*
    Effective banner height: regular pages use --banner-h; the home page is
    taller but only on desktop (Fuwari gates its lg:is-home rules behind the
    same 1024px breakpoint). Pages offset their content with --banner-h (fixed
    offset) or --banner-h-effective (track the taller home banner).
  */
  body {
    --banner-h-effective: var(--banner-h);
  }

  @media (min-width: 64rem) {
    body.is-home {
      --banner-h-effective: var(--banner-h-home);
    }
  }
</style>

<style>
  /*
    The banner band only — paper colour stays on the canvas (body in
    global.css). Height token: --banner-h / --banner-h-home (themes.css).

    The band follows the page as it scrolls (sticky), but never leaves the
    viewport entirely: `top` is pinned to -(H − 10dvh), so once the page has
    scrolled H − 10dvh the band sticks with its bottom 10dvh still visible.
    Because sticky keeps the element in flow, `margin-bottom` cancels its own
    height so header/main keep their existing offsets unchanged.

    The height transition is the cross-page morph: the element persists
    across swup navigations, only its height animates (65dvh on home/desktop
    ↔ 35dvh elsewhere). top/margin-bottom transition in lock-step so the
    pinned geometry never jumps mid-morph.
  */
  .site-banner {
    position: sticky;
    top: calc(13dvh - var(--banner-h-effective)); /* min visibility */
    height: var(--banner-h-effective);
    margin-bottom: calc(-1 * var(--banner-h-effective));
    z-index: -1;
    pointer-events: none;
    box-shadow: var(--shadow-sticky);
    transition:
      height 0.4s var(--ease-enter),
      top 0.4s var(--ease-enter),
      margin-bottom 0.4s var(--ease-enter);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-banner {
      transition: none;
    }
  }

  .band {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 90%; /* crop anchor */
  }
</style>
